              "key": "region",
              "values": [
                "au",
                "emea"
              ]
            }
          ]
        }
      ]
    }
  ],
  "cases": [
    {
      "description": "enabled when the flag requires multiple context attributes and all are matched",
      "configuration": {
        "slug": "trial-license-in-au-or-emea",
        "defaultValue": false,
        "context": {
          "targetingKey": "below-30",
          "license": "trial",
          "region": "au"
        }
      },
      "expected": {
        "value": true
      }
    },
    {
      "description": "disabled when the flag requires multiple context attributes and some have the wrong value",
      "configuration": {
        "slug": "trial-license-in-au-or-emea",
        "defaultValue": true,
        "context": {
          "targetingKey": "below-30",
          "license": "trial",
          "region": "some-other-region"
        }
      },
      "expected": {
        "value": false
      }
    },
    {
      "description": "disabled when the flag requires multiple context attributes and some are missing",
      "configuration": {
        "slug": "trial-license-in-au-or-emea",
        "defaultValue": true,
        "context": {
          "targetingKey": "below-30",
          "license": "trial"
        }
      },
      "expected": {
        "value": false
      }
    },
    {
      "description": "enabled when the flag requires multiple context attributes and all are matched but additional attributes are present",
      "configuration": {
        "slug": "trial-license-in-au-or-emea",
        "defaultValue": false,
        "context": {
          "targetingKey": "below-30",
          "license": "trial",
          "region": "au",
          "other-key": "other-value"
        }
      },
      "expected": {
        "value": true
      }
    },
    {
      "description": "disabled when the flag requires multiple context attributes and all of them are missing",
      "configuration": {
        "slug": "trial-license-in-au-or-emea",
        "defaultValue": true,
        "context": {
          "targetingKey": "below-30",
          "some-other-key": "some-other-value"
        }
      },
      "expected": {
        "value": false
      }
    },
    {
      "description": "disabled when a required context attribute contains a null value",
      "configuration": {
        "slug": "trial-license-in-au-or-emea",
        "defaultValue": true,
        "context": {
          "license": "trial",
