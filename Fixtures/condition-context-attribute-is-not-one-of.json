{
  "$schema": "../schema/fixtures.schema.json",
  "response": [
    {
      "slug": "everyone-outside-the-eu",
      "evaluationKey": "evaluation-key",
      "rules": [
        {
          "name": "Outside the EU",
          "conditions": [
            {
              "type": "context-attribute-is-not-one-of",
              "key": "region",
              "values": [
                "eu"
              ]
            }
          ]
        }
      ]
    },
    {
      "slug": "everyone-outside-the-eu-and-the-uk",
      "evaluationKey": "evaluation-key",
      "rules": [
        {
          "name": "Outside the EU and the UK",
          "conditions": [
            {
              "type": "context-attribute-is-not-one-of",
              "key": "region",
              "values": [
                "eu",
                "uk"
              ]
            }
          ]
        }
      ]
    },
    {
      "slug": "license-is-not-trial",
      "evaluationKey": "evaluation-key",
      "rules": [
        {
          "name": "Everything but trial licences",
          "conditions": [
            {
              "type": "context-attribute-is-not-one-of",
              "key": "License",
              "values": [
                "Trial"
              ]
            }
          ]
        }
      ]
    }
  ],
  "cases": [
    {
      "description": "disabled when the context attribute has an excluded value",
      "configuration": {
        "slug": "everyone-outside-the-eu",
        "defaultValue": true,
        "context": {
          "region": "eu"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "enabled when the context attribute has a value that is not excluded",
      "configuration": {
        "slug": "everyone-outside-the-eu",
        "defaultValue": false,
        "context": {
          "region": "au"
        }
      },
      "expected": {
        "value": true,
        "reason": "Matched rule 'Outside the EU'."
      }
    },
    {
      "description": "enabled when the context attribute is missing, because an absent attribute cannot be excluded",
      "configuration": {
        "slug": "everyone-outside-the-eu",
        "defaultValue": false,
        "context": { }
      },
      "expected": {
        "value": true,
        "reason": "Matched rule 'Outside the EU'."
      }
    },
    {
      "description": "disabled when the context attribute matches any value in a multi-value exclusion",
      "configuration": {
        "slug": "everyone-outside-the-eu-and-the-uk",
        "defaultValue": true,
        "context": {
          "region": "uk"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "enabled when the context attribute matches no value in a multi-value exclusion",
      "configuration": {
        "slug": "everyone-outside-the-eu-and-the-uk",
        "defaultValue": false,
        "context": {
          "region": "au"
        }
      },
      "expected": {
        "value": true,
        "reason": "Matched rule 'Outside the EU and the UK'."
      }
    },
    {
      "description": "disabled when an excluded context attribute key differs only by case, so the exclusion still applies",
      "configuration": {
        "slug": "license-is-not-trial",
        "defaultValue": true,
        "context": {
          "license": "Trial"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "disabled when an excluded context attribute value differs only by case, so the exclusion still applies",
      "configuration": {
        "slug": "license-is-not-trial",
        "defaultValue": true,
        "context": {
          "License": "trial"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "disabled when an excluded context attribute key and value are both lowercase and the condition is not",
      "configuration": {
        "slug": "license-is-not-trial",
        "defaultValue": true,
        "context": {
          "license": "trial"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "disabled when an excluded context attribute key and value are already uppercase, so only the condition side is folded",
      "configuration": {
        "slug": "license-is-not-trial",
        "defaultValue": true,
        "context": {
          "LICENSE": "TRIAL"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "disabled when the context holds the same excluded attribute key in two casings and the first one matches",
      "configuration": {
        "slug": "license-is-not-trial",
        "defaultValue": true,
        "context": {
          "License": "Trial",
          "license": "Enterprise"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    },
    {
      "description": "disabled when the context holds the same excluded attribute key in two casings and the second one matches",
      "configuration": {
        "slug": "license-is-not-trial",
        "defaultValue": true,
        "context": {
          "License": "Enterprise",
          "license": "Trial"
        }
      },
      "expected": {
        "value": false,
        "reason": "Did not match any rules."
      }
    }
  ]
}
