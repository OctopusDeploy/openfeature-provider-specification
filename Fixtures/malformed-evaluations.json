  "cases": [
    {
      "description": "returns an error and the default value when an evaluation has neither a value nor rules",
      "configuration": {
        "slug": "flag-with-no-value-or-rules",
        "defaultValue": false
      },
      "expected": {
        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when an evaluation has both a value and rules",
      "configuration": {
        "slug": "flag-with-both-value-and-rules",
        "defaultValue": false,
        "context": {
          "ring": "beta"
        }
      },
      "expected": {
        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when an evaluation has rules but no evaluation key",
