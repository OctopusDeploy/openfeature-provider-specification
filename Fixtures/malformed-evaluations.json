        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when a percentage condition has no percentage",
      "configuration": {
        "slug": "flag-with-percentage-condition-missing-percentage",
        "defaultValue": false,
        "context": {
          "targetingKey": "red-sand"
        }
      },
      "expected": {
        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when a context attribute condition has no values",
      "configuration": {
        "slug": "flag-with-attribute-condition-missing-values",
        "defaultValue": true,
        "context": {
          "license": "trial"
        }
      },
      "expected": {
        "value": true,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when a percentage is above 100, rather than including everyone",
      "configuration": {
        "slug": "flag-with-percentage-out-of-range",
        "defaultValue": false,
        "context": {
          "targetingKey": "red-sand"
        }
      },
      "expected": {
        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when a condition has no type at all",
      "configuration": {
        "slug": "flag-with-condition-missing-type",
        "defaultValue": true,
        "context": {
          "license": "trial"
        }
      },
      "expected": {
        "value": true,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when a condition has no type, even though another rule matches, because a malformed condition fails the whole evaluation rather than just its own rule",
      "configuration": {
        "slug": "flag-with-untyped-condition-in-one-of-two-rules",
        "defaultValue": false,
        "context": {
          "license": "trial",
          "ring": "beta"
        }
      },
      "expected": {
        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when an evaluation is resolved by the server but has no reason",
      "configuration": {
        "slug": "flag-with-value-but-no-reason",
        "defaultValue": false
      },
      "expected": {
        "value": false,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "evaluates the rest of the response, so a malformed evaluation only fails its own flag",
      "configuration": {
        "slug": "well-formed-flag",
        "defaultValue": false
      },
      "expected": {
        "value": true,
        "reason": "The flag is enabled for this environment."
      }
    }
