        }
      },
      "expected": {
        "value": true,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when an evaluation defers to the client with no rules",
      "configuration": {
        "slug": "flag-with-empty-rules",
        "defaultValue": true
      },
      "expected": {
        "value": true,
        "errorCode": "PARSE_ERROR"
      }
    },
    {
      "description": "returns an error and the default value when a rule has no conditions",
