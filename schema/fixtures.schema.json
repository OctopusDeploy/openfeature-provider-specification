{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["response", "cases"],
  "additionalProperties": false,
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["name", "conditions"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/condition"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": ["percentage-by-context", "context-attribute-is-one-of", "context-attribute-is-not-one-of"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "percentage-by-context"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["percentage"],
            "properties": {
              "percentage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["context-attribute-is-one-of", "context-attribute-is-not-one-of"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["key", "values"],
            "properties": {
              "key": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "response": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "slug": {
            "type": "string"
          },
          "value": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "evaluationKey": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/rule"
            }
          }
        },
        "oneOf": [
          {
            "required": ["slug", "value", "reason"],
            "not": {
              "anyOf": [{ "required": ["rules"] }, { "required": ["evaluationKey"] }]
            }
          },
          {
            "required": ["slug", "evaluationKey", "rules"],
            "not": {
              "anyOf": [{ "required": ["value"] }, { "required": ["reason"] }]
            }
          }
        ]
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "configuration", "expected"],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "configuration": {
            "type": "object",
            "required": ["slug", "defaultValue"],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string"
              },
              "context": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "defaultValue": {
                "type": "boolean"
              }
            }
          },
          "expected": {
            "type": "object",
            "required": ["value"],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "errorCode": {
                "enum": ["PROVIDER_NOT_READY", "FLAG_NOT_FOUND", "PARSE_ERROR", "TYPE_MISMATCH", "TARGETING_KEY_MISSING", "INVALID_CONTEXT", "PROVIDER_FATAL", "GENERAL", null]
              }
            }
          }
        }
      }
    }
  }
}
